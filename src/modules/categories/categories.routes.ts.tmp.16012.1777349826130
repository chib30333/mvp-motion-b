import { Router } from "express";
import { UserRole } from "@prisma/client";
import { requireAuth } from "../../core/middleware/auth.middleware.ts";
import { requireRole } from "../../core/middleware/role.middleware.ts";
import { validate } from "../../core/middleware/validate.middleware.ts";
import { asyncHandler } from "../../core/utils/asyncHandler.ts";
import { categoriesController } from "./categories.controller.ts";
import {
    createCategorySchema,
    updateCategorySchema,
    categoryParamsSchema,
    listCategoriesQuerySchema,
} from "./categories.schema.ts";

const router = Router();

router.get(
    "/",
    validate({ query: listCategoriesQuerySchema }),
    asyncHandler(categoriesController.list)
);

router.post(
    "/",
    requireAuth,
    requireRole(UserRole.MANAGER, UserRole.ADMIN),
    validate({ body: createCategorySchema }),
    asyncHandler(categoriesController.create)
);

router.patch(
    "/:id",
    requireAuth,
    requireRole(UserRole.MANAGER, UserRole.ADMIN),
    validate({ params: categoryParamsSchema, body: updateCategorySchema }),
    asyncHandler(categoriesController.update)
);

router.delete(
    "/:id",
    requireAuth,
    requireRole(UserRole.MANAGER, UserRole.ADMIN),
    validate({ params: categoryParamsSchema }),
    asyncHandler(categoriesController.deactivate)
);

export default router;
