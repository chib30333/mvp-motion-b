import { prisma } from "../../core/db/prisma.ts";
import { ConflictError } from "../../core/errors/ConflictError.ts";
import { NotFoundError } from "../../core/errors/NotFoundError.ts";

type CreateCityInput = {
    name: string;
    slug: string;
    countryCode?: string;
    isActive?: boolean;
};

type UpdateCityInput = Partial<CreateCityInput>;

export const citiesService = {
    async list(filter: { isActive?: boolean }) {
        return prisma.city.findMany({
            where: filter.isActive !== undefined ? { isActive: filter.isActive } : undefined,
            orderBy: { name: "asc" },
        });
    },

    async create(input: CreateCityInput) {
        const existing = await prisma.city.findFirst({
            where: { OR: [{ name: input.name }, { slug: input.slug }] },
        });

        if (existing) {
            throw new ConflictError("City with this name or slug already exists");
        }

        return prisma.city.create({
            data: {
                name: input.name,
                slug: input.slug,
                countryCode: input.countryCode ?? "RU",
                isActive: input.isActive ?? true,
            },
        });
    },

    async update(id: string, input: UpdateCityInput) {
        const existing = await prisma.city.findUnique({ where: { id } });
        if (!existing) throw new NotFoundError("City not found");

        return prisma.city.update({
            where: { id },
            data: input,
        });
    },

    async deactivate(id: string) {
        const existing = await prisma.city.findUnique({ where: { id } });
        if (!existing) throw new NotFoundError("City not found");

        return prisma.city.update({
            where: { id },
            data: { isActive: false },
        });
    },
};
