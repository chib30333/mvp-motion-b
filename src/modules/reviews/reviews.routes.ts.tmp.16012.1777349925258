import { Router } from "express";
import { UserRole } from "@prisma/client";
import { requireAuth } from "../../core/middleware/auth.middleware.ts";
import { requireRole } from "../../core/middleware/role.middleware.ts";
import { validate } from "../../core/middleware/validate.middleware.ts";
import { asyncHandler } from "../../core/utils/asyncHandler.ts";
import { reviewsController } from "./reviews.controller.ts";
import {
    createReviewSchema,
    listProviderReviewsQuerySchema,
} from "./reviews.schema.ts";

const router = Router();

router.get(
    "/",
    validate({ query: listProviderReviewsQuerySchema }),
    asyncHandler(reviewsController.listByProvider)
);

router.get(
    "/me",
    requireAuth,
    asyncHandler(reviewsController.getMine)
);

router.post(
    "/",
    requireAuth,
    requireRole(UserRole.CUSTOMER, UserRole.PROVIDER),
    validate({ body: createReviewSchema }),
    asyncHandler(reviewsController.create)
);

export default router;
