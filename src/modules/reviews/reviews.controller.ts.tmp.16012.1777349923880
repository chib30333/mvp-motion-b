import type { Request, Response } from "express";
import { reviewsService } from "./reviews.service.ts";

export const reviewsController = {
    async create(req: Request, res: Response) {
        const review = await reviewsService.create({
            userId: req.user!.userId,
            bookingId: req.body.bookingId,
            rating: req.body.rating,
            comment: req.body.comment,
        });
        res.status(201).json({ success: true, data: review });
    },

    async listByProvider(req: Request, res: Response) {
        const providerId = String(req.query.providerId);
        const page = req.query.page ? Number(req.query.page) : 1;
        const pageSize = req.query.pageSize ? Number(req.query.pageSize) : 20;
        const result = await reviewsService.listByProvider(providerId, page, pageSize);
        res.status(200).json({ items: result.items, meta: result.meta });
    },

    async getMine(req: Request, res: Response) {
        const items = await reviewsService.getMine(req.user!.userId);
        res.status(200).json({ success: true, data: items });
    },
};
